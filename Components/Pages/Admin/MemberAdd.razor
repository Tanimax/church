@page "/admin/members/add"
@attribute [Authorize]
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav
@inject EmailService EmailService

<PageTitle>Ajouter un membre</PageTitle>

<h1>Ajouter un membre</h1>

@if (createdMember is null)
{
    <EditForm Model="formModel" OnValidSubmit="HandleSubmit" FormName="add-member">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Prénom</label>
                <InputText class="form-control" @bind-Value="formModel!.FirstName" />
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Nom</label>
                <InputText class="form-control" @bind-Value="formModel!.LastName" />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Téléphone (optionnel)</label>
            <InputText class="form-control" @bind-Value="formModel!.Phone" />
        </div>

        <div class="mb-3">
            <label class="form-label">Courriel (optionnel — un lien de bienvenue lui sera envoyé)</label>
            <InputText type="email" class="form-control" @bind-Value="formModel!.Email" />
        </div>

        <div class="mb-3">
            <label class="form-label">Sexe</label>
            <InputSelect class="form-select" @bind-Value="formModel!.Sexe">
                <option value="">-- Sélectionner --</option>
                <option value="Homme">Homme</option>
                <option value="Femme">Femme</option>
            </InputSelect>
        </div>

        <div class="mb-3">
            <label class="form-label">État matrimonial</label>
            <InputSelect class="form-select" @bind-Value="formModel!.EtatMatrimonial">
                <option value="">-- Sélectionner --</option>
                <option value="Celibataire">Célibataire</option>
                <option value="Marie">Marié(e)</option>
                <option value="Divorce">Divorcé(e)</option>
                <option value="Veuf">Veuf(ve)</option>
            </InputSelect>
        </div>

        <div class="row">
            <div class="col-auto mb-3">
                <label class="form-label">Jour de naissance (optionnel)</label>
                <InputSelect class="form-select" @bind-Value="formModel!.BirthDay">
                    <option value="">--</option>
                    @for (var day = 1; day <= 31; day++)
                    {
                        <option value="@day">@day</option>
                    }
                </InputSelect>
            </div>

            <div class="col-auto mb-3">
                <label class="form-label">Mois de naissance (optionnel)</label>
                <InputSelect class="form-select" @bind-Value="formModel!.BirthMonth">
                    <option value="">--</option>
                    @for (var month = 1; month <= 12; month++)
                    {
                        <option value="@month">@MonthNames[month]</option>
                    }
                </InputSelect>
            </div>
        </div>

        <div class="mb-3 form-check">
            <InputCheckbox class="form-check-input" id="isBaptized" @bind-Value="formModel!.IsBaptized" />
            <label class="form-check-label" for="isBaptized">Baptisé(e)</label>
        </div>

        <button type="submit" class="btn btn-primary">Créer la carte</button>
        <a href="/admin/members" class="btn btn-link">Annuler</a>
    </EditForm>
}
else
{
    <div class="alert alert-success">
        <h4>Membre créé : @createdMember.FullName</h4>
        <p>Partage ce lien avec le membre (SMS, WhatsApp...) :</p>
        <div class="input-group mb-3">
            <input type="text" class="form-control" readonly value="@cardUrl" />
        </div>
        <img src="/api/members/@createdMember.Token/qr.png" alt="QR code" style="max-width:220px" />
        @if (!string.IsNullOrWhiteSpace(createdMember.Email))
        {
            <p class="mt-3 mb-0">📧 Un courriel de bienvenue a été envoyé à @createdMember.Email.</p>
        }
    </div>

    <a href="/admin/members/add" class="btn btn-primary">Ajouter un autre membre</a>
    <a href="/admin/members" class="btn btn-link">Retour à la liste</a>
}

@code {
    private static readonly string[] MonthNames =
        { "", "Janvier", "Février", "Mars", "Avril", "Mai", "Juin", "Juillet", "Août", "Septembre", "Octobre", "Novembre", "Décembre" };

    [SupplyParameterFromForm]
    private MemberFormModel? formModel { get; set; }

    private Member? createdMember;
    private string cardUrl = "";

    protected override void OnInitialized()
    {
        formModel ??= new MemberFormModel();
    }

    private async Task HandleSubmit()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var member = new Member
        {
            FirstName = formModel!.FirstName.Trim(),
            LastName = formModel.LastName.Trim(),
            Phone = string.IsNullOrWhiteSpace(formModel.Phone) ? null : formModel.Phone.Trim(),
            Email = string.IsNullOrWhiteSpace(formModel.Email) ? null : formModel.Email.Trim(),
            Token = TokenService.GenerateToken(),
            CreatedAt = DateTime.UtcNow,
            Gender = formModel.Sexe,
            IsBaptized = formModel.IsBaptized,
            MaritalStatus = formModel.EtatMatrimonial,
            BirthDay = formModel.BirthDay,
            BirthMonth = formModel.BirthMonth
        };
        db.Members.Add(member);
        await db.SaveChangesAsync();

        createdMember = member;
        cardUrl = $"{Nav.BaseUri.TrimEnd('/')}/card/{member.Token}";

        if (!string.IsNullOrWhiteSpace(member.Email))
        {
            await EmailService.SendWelcomeEmailAsync(member.Email, member.FullName, cardUrl);
        }
    }
}
