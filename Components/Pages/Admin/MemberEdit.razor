@page "/admin/members/edit/{Id:int}"
@attribute [Authorize]
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav

<PageTitle>Modifier un membre</PageTitle>

<h1>Modifier un membre</h1>

@if (notFound)
{
    <p class="text-muted">Membre introuvable.</p>
    <a href="/admin/members" class="btn btn-link">Retour à la liste</a>
}
else if (formModel is null)
{
    <p><em>Chargement...</em></p>
}
else
{
    <EditForm Model="formModel" OnValidSubmit="HandleSubmit" FormName="edit-member">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Prénom</label>
                <InputText class="form-control" @bind-Value="formModel.FirstName" />
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Nom</label>
                <InputText class="form-control" @bind-Value="formModel.LastName" />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Téléphone (optionnel)</label>
            <InputText class="form-control" @bind-Value="formModel.Phone" />
        </div>

        <div class="mb-3">
            <label class="form-label">Courriel (optionnel)</label>
            <InputText type="email" class="form-control" @bind-Value="formModel.Email" />
        </div>

        <div class="mb-3">
            <label class="form-label">Sexe</label>
            <InputSelect class="form-select" @bind-Value="formModel.Sexe">
                <option value="">-- Sélectionner --</option>
                <option value="Homme">Homme</option>
                <option value="Femme">Femme</option>
            </InputSelect>
        </div>

        <div class="mb-3">
            <label class="form-label">État matrimonial</label>
            <InputSelect class="form-select" @bind-Value="formModel.EtatMatrimonial">
                <option value="">-- Sélectionner --</option>
                <option value="Celibataire">Célibataire</option>
                <option value="Marie">Marié(e)</option>
                <option value="Divorce">Divorcé(e)</option>
                <option value="Veuf">Veuf(ve)</option>
            </InputSelect>
        </div>

        <div class="row">
            <div class="col-auto mb-3">
                <label class="form-label">Jour de naissance (optionnel)</label>
                <InputSelect class="form-select" @bind-Value="formModel.BirthDay">
                    <option value="">--</option>
                    @for (var day = 1; day <= 31; day++)
                    {
                        <option value="@day">@day</option>
                    }
                </InputSelect>
            </div>

            <div class="col-auto mb-3">
                <label class="form-label">Mois de naissance (optionnel)</label>
                <InputSelect class="form-select" @bind-Value="formModel.BirthMonth">
                    <option value="">--</option>
                    @for (var month = 1; month <= 12; month++)
                    {
                        <option value="@month">@MonthNames[month]</option>
                    }
                </InputSelect>
            </div>
        </div>

        <div class="mb-3 form-check">
            <InputCheckbox class="form-check-input" id="isBaptized" @bind-Value="formModel.IsBaptized" />
            <label class="form-check-label" for="isBaptized">Baptisé(e)</label>
        </div>

        <button type="submit" class="btn btn-primary">Enregistrer</button>
        <a href="/admin/members" class="btn btn-link">Annuler</a>
    </EditForm>
}

@code {
    private static readonly string[] MonthNames =
        { "", "Janvier", "Février", "Mars", "Avril", "Mai", "Juin", "Juillet", "Août", "Septembre", "Octobre", "Novembre", "Décembre" };

    [Parameter]
    public int Id { get; set; }

    [SupplyParameterFromForm]
    private MemberFormModel? formModel { get; set; }

    private bool notFound;

    protected override async Task OnParametersSetAsync()
    {
        if (formModel is not null)
        {
            // Returning from a form post (e.g. validation failure) — keep the posted values.
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var member = await db.Members.FindAsync(Id);
        if (member is null)
        {
            notFound = true;
            return;
        }

        formModel = new MemberFormModel
        {
            FirstName = member.FirstName,
            LastName = member.LastName,
            Phone = member.Phone,
            Email = member.Email,
            Sexe = member.Gender,
            IsBaptized = member.IsBaptized,
            EtatMatrimonial = member.MaritalStatus,
            BirthDay = member.BirthDay,
            BirthMonth = member.BirthMonth
        };
    }

    private async Task HandleSubmit()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var member = await db.Members.FindAsync(Id);
        if (member is null)
        {
            notFound = true;
            return;
        }

        member.FirstName = formModel!.FirstName.Trim();
        member.LastName = formModel.LastName.Trim();
        member.Phone = string.IsNullOrWhiteSpace(formModel.Phone) ? null : formModel.Phone.Trim();
        member.Email = string.IsNullOrWhiteSpace(formModel.Email) ? null : formModel.Email.Trim();
        member.Gender = formModel.Sexe;
        member.IsBaptized = formModel.IsBaptized;
        member.MaritalStatus = formModel.EtatMatrimonial;
        member.BirthDay = formModel.BirthDay;
        member.BirthMonth = formModel.BirthMonth;

        await db.SaveChangesAsync();
        Nav.NavigateTo("/admin/members");
    }
}
