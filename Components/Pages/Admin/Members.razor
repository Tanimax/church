@page "/admin/members"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav
@inject EmailService EmailService

<PageTitle>Membres</PageTitle>

<h1>Membres</h1>

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div class="d-flex flex-wrap gap-2">
        <input type="search" class="form-control w-auto" placeholder="Rechercher par nom ou prénom..."
               @bind="searchTerm" @bind:event="oninput" @bind:after="ResetPage" />
        <select id="baptizedFilter" class="form-select w-auto" @bind="baptizedFilterValue" @bind:after="ResetPage">
            <option value="">Tous (baptisé ou non)</option>
            <option value="true">Baptisé(e)</option>
            <option value="false">Non baptisé(e)</option>
        </select>
        <select id="activeFilter" class="form-select w-auto" @bind="activeFilterValue" @bind:after="ResetPage">
            <option value="">Tous (actif ou inactif)</option>
            <option value="true">Actif</option>
            <option value="false">Inactif</option>
        </select>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" href="@ExportUrl" target="_blank">Exporter en Excel</a>
        <button type="button" class="btn btn-primary" @onclick="OpenAddModal">+ Ajouter un membre</button>
    </div>
</div>

@if (selectedIds.Count > 0)
{
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2 p-2 px-3 rounded" style="background: var(--brass-100);">
        <span>@selectedIds.Count membre(s) sélectionné(s)</span>
        <div class="d-flex gap-2">
            <a class="btn btn-sm btn-outline-secondary" href="@GenerateCardsUrl" target="_blank">Générer les cartes</a>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearSelection">Désélectionner tout</button>
        </div>
    </div>
}

@if (showAddModal)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" @onclick="CloseAddModal">
        <div class="modal-dialog" role="document" @onclick:stopPropagation="true">
            <div class="modal-content">
                @if (addCreatedMember is null)
                {
                    <EditForm Model="addFormModel" OnValidSubmit="HandleAddSubmit">
                        <DataAnnotationsValidator />
                        <div class="modal-header">
                            <h5 class="modal-title">Ajouter un membre</h5>
                            <button type="button" class="btn-close" aria-label="Fermer" @onclick="CloseAddModal"></button>
                        </div>
                        <div class="modal-body">
                            <ValidationSummary />

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Prénom</label>
                                    <InputText class="form-control" @bind-Value="addFormModel.FirstName" />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Nom</label>
                                    <InputText class="form-control" @bind-Value="addFormModel.LastName" />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Téléphone (optionnel)</label>
                                <InputText class="form-control" @bind-Value="addFormModel.Phone" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Courriel (optionnel — un lien de bienvenue lui sera envoyé)</label>
                                <InputText type="email" class="form-control" @bind-Value="addFormModel.Email" />
                            </div>

                            <div class="row">
                                <div class="col-auto mb-3">
                                    <label class="form-label">Jour de naissance (optionnel)</label>
                                    <InputSelect class="form-select" @bind-Value="addFormModel.BirthDay">
                                        <option value="">--</option>
                                        @for (var day = 1; day <= 31; day++)
                                        {
                                            <option value="@day">@day</option>
                                        }
                                    </InputSelect>
                                </div>

                                <div class="col-auto mb-3">
                                    <label class="form-label">Mois de naissance (optionnel)</label>
                                    <InputSelect class="form-select" @bind-Value="addFormModel.BirthMonth">
                                        <option value="">--</option>
                                        @for (var month = 1; month <= 12; month++)
                                        {
                                            <option value="@month">@MonthNames[month]</option>
                                        }
                                    </InputSelect>
                                </div>
                            </div>

                            <div class="mb-3 form-check">
                                <InputCheckbox class="form-check-input" id="addIsBaptized" @bind-Value="addFormModel.IsBaptized" />
                                <label class="form-check-label" for="addIsBaptized">Baptisé(e)</label>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-link" @onclick="CloseAddModal">Annuler</button>
                            <button type="submit" class="btn btn-primary">Créer la carte</button>
                        </div>
                    </EditForm>
                }
                else
                {
                    <div class="modal-header">
                        <h5 class="modal-title">Membre créé : @addCreatedMember.FullName</h5>
                        <button type="button" class="btn-close" aria-label="Fermer" @onclick="CloseAddModal"></button>
                    </div>
                    <div class="modal-body">
                        <p>Partage ce lien avec le membre (SMS, WhatsApp...) :</p>
                        <div class="input-group mb-3">
                            <input type="text" class="form-control" readonly value="@addCardUrl" />
                        </div>
                        <img src="/api/members/@addCreatedMember.Token/qr.png" alt="QR code" style="max-width:220px" />
                        @if (!string.IsNullOrWhiteSpace(addCreatedMember.Email))
                        {
                            <p class="mt-3 mb-0">📧 Un courriel de bienvenue a été envoyé à @addCreatedMember.Email.</p>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="ResetAddForm">Ajouter un autre membre</button>
                        <button type="button" class="btn btn-primary" @onclick="CloseAddModal">Fermer</button>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@if (editingMember is not null)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" @onclick="CloseEditModal">
        <div class="modal-dialog" role="document" @onclick:stopPropagation="true">
            <div class="modal-content">
                <EditForm Model="editFormModel" OnValidSubmit="HandleEditSubmit">
                    <DataAnnotationsValidator />
                    <div class="modal-header">
                        <h5 class="modal-title">Modifier @editingMember.FullName</h5>
                        <button type="button" class="btn-close" aria-label="Fermer" @onclick="CloseEditModal"></button>
                    </div>
                    <div class="modal-body">
                        <ValidationSummary />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Prénom</label>
                                <InputText class="form-control" @bind-Value="editFormModel.FirstName" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Nom</label>
                                <InputText class="form-control" @bind-Value="editFormModel.LastName" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Téléphone (optionnel)</label>
                            <InputText class="form-control" @bind-Value="editFormModel.Phone" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Courriel (optionnel)</label>
                            <InputText type="email" class="form-control" @bind-Value="editFormModel.Email" />
                        </div>

                        <div class="row">
                            <div class="col-auto mb-3">
                                <label class="form-label">Jour de naissance (optionnel)</label>
                                <InputSelect class="form-select" @bind-Value="editFormModel.BirthDay">
                                    <option value="">--</option>
                                    @for (var day = 1; day <= 31; day++)
                                    {
                                        <option value="@day">@day</option>
                                    }
                                </InputSelect>
                            </div>

                            <div class="col-auto mb-3">
                                <label class="form-label">Mois de naissance (optionnel)</label>
                                <InputSelect class="form-select" @bind-Value="editFormModel.BirthMonth">
                                    <option value="">--</option>
                                    @for (var month = 1; month <= 12; month++)
                                    {
                                        <option value="@month">@MonthNames[month]</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>

                        <div class="mb-3 form-check">
                            <InputCheckbox class="form-check-input" id="editIsBaptized" @bind-Value="editFormModel.IsBaptized" />
                            <label class="form-check-label" for="editIsBaptized">Baptisé(e)</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-link" @onclick="CloseEditModal">Annuler</button>
                        <button type="submit" class="btn btn-primary">Enregistrer</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@if (viewingCardMember is not null)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" @onclick="CloseCardModal">
        <div class="modal-dialog" role="document" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Carte de @viewingCardMember.FullName</h5>
                    <button type="button" class="btn-close" aria-label="Fermer" @onclick="CloseCardModal"></button>
                </div>
                <div class="modal-body text-center">
                    <img src="/api/members/@viewingCardMember.Token/qr.png" alt="QR code" style="max-width:220px" />
                    <div class="input-group mt-3">
                        <input type="text" class="form-control" readonly value="@CardUrl(viewingCardMember.Token)" />
                        <button type="button" class="btn btn-outline-secondary"
                                data-url="@CardUrl(viewingCardMember.Token)" onclick="copyToClipboard(this)">
                            Copier le lien
                        </button>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" @onclick="CloseCardModal">Fermer</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@if (members is null)
{
    <p><em>Chargement...</em></p>
}
else if (!filteredMembers.Any())
{
    <p class="text-muted">Aucun membre trouvé.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle" style="min-width:800px;">
            <colgroup>
                <col style="width:40px" />
                <col style="width:110px" />
                <col style="width:110px" />
                <col style="width:130px" />
                <col style="width:110px" />
                <col style="width:90px" />
                <col style="width:90px" />
                <col style="width:260px" />
            </colgroup>
            <thead>
                <tr>
                    <th>
                        <input type="checkbox" class="form-check-input" title="Tout sélectionner (page courante)"
                               checked="@AreAllVisibleSelected" @onchange="ToggleSelectAllVisible" />
                    </th>
                    <th>Nom</th>
                    <th>Prénom</th>
                    <th>Téléphone</th>
                    <th>Naissance</th>
                    <th>Baptisé</th>
                    <th>Statut</th>
                    <th>Carte</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var member in pagedMembers)
                {
                    <tr>
                        <td>
                            <input type="checkbox" class="form-check-input" checked="@selectedIds.Contains(member.Id)"
                                   @onchange="() => ToggleSelect(member.Id)" />
                        </td>
                        <td>@member.LastName</td>
                        <td>@member.FirstName</td>
                        <td>@member.Phone</td>
                        <td>@(member.BirthdayLabel ?? "—")</td>
                        <td>
                            @if (member.IsBaptized)
                            {
                                <span class="badge bg-success">Oui</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Non</span>
                            }
                        </td>
                        <td>
                            @if (member.IsActive)
                            {
                                <span class="badge bg-success">Actif</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactif</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => OpenCardModal(member)">
                                    Voir la carte
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => OpenEditModal(member)">
                                    Modifier
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleActive(member)">
                                    @(member.IsActive ? "Désactiver" : "Réactiver")
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span class="text-muted">
            @filteredMembers.Count membre(s) — page @currentPage sur @totalPages
        </span>
        <div class="d-flex align-items-center gap-2">
            <label class="text-muted mb-0" for="pageSize">Par page</label>
            <select id="pageSize" class="form-select form-select-sm w-auto" @bind="pageSize" @bind:event="onchange" @bind:after="ResetPage">
                <option value="10">10</option>
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
                <option value="@int.MaxValue">Tous</option>
            </select>
            <div class="btn-group">
                <button type="button" class="btn btn-outline-secondary" disabled="@(currentPage <= 1)" @onclick="() => GoToPage(currentPage - 1)">
                    ‹ Précédent
                </button>
                <button type="button" class="btn btn-outline-secondary" disabled="@(currentPage >= totalPages)" @onclick="() => GoToPage(currentPage + 1)">
                    Suivant ›
                </button>
            </div>
        </div>
    </div>
}

@code {
    private static readonly string[] MonthNames =
        { "", "Janvier", "Février", "Mars", "Avril", "Mai", "Juin", "Juillet", "Août", "Septembre", "Octobre", "Novembre", "Décembre" };

    private List<Member>? members;
    private string searchTerm = "";
    private string baptizedFilterValue = "";
    private string activeFilterValue = "";
    private int currentPage = 1;
    private int pageSize = 10;

    private HashSet<int> selectedIds = new();

    private bool showAddModal;
    private MemberFormModel addFormModel = new();
    private Member? addCreatedMember;
    private string addCardUrl = "";

    private Member? editingMember;
    private MemberFormModel editFormModel = new();

    private Member? viewingCardMember;

    private string CardUrl(string token) => $"{Nav.BaseUri.TrimEnd('/')}/card/{token}";

    private string ExportUrl => $"/admin/members/export.csv?search={Uri.EscapeDataString(searchTerm)}&baptized={baptizedFilterValue}&active={activeFilterValue}";

    private string GenerateCardsUrl => "/admin/members/cards.zip?" + string.Join('&', selectedIds.Select(id => $"ids={id}"));

    private bool AreAllVisibleSelected => pagedMembers.Any() && pagedMembers.All(m => selectedIds.Contains(m.Id));

    private void ToggleSelect(int memberId)
    {
        if (!selectedIds.Add(memberId))
        {
            selectedIds.Remove(memberId);
        }
    }

    private void ToggleSelectAllVisible()
    {
        if (AreAllVisibleSelected)
        {
            foreach (var member in pagedMembers)
            {
                selectedIds.Remove(member.Id);
            }
        }
        else
        {
            foreach (var member in pagedMembers)
            {
                selectedIds.Add(member.Id);
            }
        }
    }

    // Selection persists across pages, so clearing it needs to be independent of what's
    // currently visible — the header checkbox only toggles the current page.
    private void ClearSelection() => selectedIds.Clear();

    private bool? baptizedFilter => baptizedFilterValue switch
    {
        "true" => true,
        "false" => false,
        _ => null
    };

    private bool? activeFilter => activeFilterValue switch
    {
        "true" => true,
        "false" => false,
        _ => null
    };

    private List<Member> filteredMembers =>
        members is null
            ? []
            : members
                .Where(m => string.IsNullOrWhiteSpace(searchTerm) || m.FullName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
                .Where(m => baptizedFilter is null || m.IsBaptized == baptizedFilter)
                .Where(m => activeFilter is null || m.IsActive == activeFilter)
                .ToList();

    private int totalPages => Math.Max(1, (int)Math.Ceiling(filteredMembers.Count / (double)pageSize));

    private IEnumerable<Member> pagedMembers =>
        filteredMembers.Skip((Math.Min(currentPage, totalPages) - 1) * pageSize).Take(pageSize);

    private void ResetPage() => currentPage = 1;

    private void GoToPage(int page) => currentPage = Math.Clamp(page, 1, totalPages);

    protected override async Task OnInitializedAsync()
    {
        await LoadMembers();
    }

    private async Task LoadMembers()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        members = await db.Members.OrderBy(m => m.LastName).ThenBy(m => m.FirstName).ToListAsync();
    }

    private void OpenAddModal()
    {
        addFormModel = new MemberFormModel();
        addCreatedMember = null;
        showAddModal = true;
    }

    private void CloseAddModal() => showAddModal = false;

    private void ResetAddForm()
    {
        addFormModel = new MemberFormModel();
        addCreatedMember = null;
    }

    private async Task HandleAddSubmit()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var member = new Member
        {
            FirstName = addFormModel.FirstName.Trim(),
            LastName = addFormModel.LastName.Trim(),
            Phone = string.IsNullOrWhiteSpace(addFormModel.Phone) ? null : addFormModel.Phone.Trim(),
            Email = string.IsNullOrWhiteSpace(addFormModel.Email) ? null : addFormModel.Email.Trim(),
            Token = TokenService.GenerateToken(),
            CreatedAt = DateTime.UtcNow,
            IsBaptized = addFormModel.IsBaptized,
            BirthDay = addFormModel.BirthDay,
            BirthMonth = addFormModel.BirthMonth
        };
        db.Members.Add(member);
        await db.SaveChangesAsync();

        addCreatedMember = member;
        addCardUrl = $"{Nav.BaseUri.TrimEnd('/')}/card/{member.Token}";

        if (!string.IsNullOrWhiteSpace(member.Email))
        {
            await EmailService.SendWelcomeEmailAsync(member.Email, member.FullName, addCardUrl);
        }

        await LoadMembers();
    }

    private void OpenEditModal(Member member)
    {
        editingMember = member;
        editFormModel = new MemberFormModel
        {
            FirstName = member.FirstName,
            LastName = member.LastName,
            Phone = member.Phone,
            Email = member.Email,
            IsBaptized = member.IsBaptized,
            BirthDay = member.BirthDay,
            BirthMonth = member.BirthMonth
        };
    }

    private void CloseEditModal() => editingMember = null;

    private void OpenCardModal(Member member) => viewingCardMember = member;

    private void CloseCardModal() => viewingCardMember = null;

    private async Task HandleEditSubmit()
    {
        if (editingMember is null)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var tracked = await db.Members.FindAsync(editingMember.Id);
        if (tracked is null)
        {
            editingMember = null;
            await LoadMembers();
            return;
        }

        tracked.FirstName = editFormModel.FirstName.Trim();
        tracked.LastName = editFormModel.LastName.Trim();
        tracked.Phone = string.IsNullOrWhiteSpace(editFormModel.Phone) ? null : editFormModel.Phone.Trim();
        tracked.Email = string.IsNullOrWhiteSpace(editFormModel.Email) ? null : editFormModel.Email.Trim();
        tracked.IsBaptized = editFormModel.IsBaptized;
        tracked.BirthDay = editFormModel.BirthDay;
        tracked.BirthMonth = editFormModel.BirthMonth;

        await db.SaveChangesAsync();

        editingMember = null;
        await LoadMembers();
    }

    private async Task ToggleActive(Member member)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var tracked = await db.Members.FindAsync(member.Id);
        if (tracked is not null)
        {
            tracked.IsActive = !tracked.IsActive;
            await db.SaveChangesAsync();
            member.IsActive = tracked.IsActive;
        }
    }
}
