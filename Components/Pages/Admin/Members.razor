@page "/admin/members"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav

<PageTitle>Membres</PageTitle>

<h1>Membres</h1>

<div class="d-flex justify-content-between align-items-center mb-3">
    <input type="search" class="form-control w-auto" placeholder="Rechercher un membre..."
           @bind="searchTerm" @bind:event="oninput" @bind:after="ResetPage" />
    <a class="btn btn-primary" href="/admin/members/add">+ Ajouter un membre</a>
</div>

@if (members is null)
{
    <p><em>Chargement...</em></p>
}
else if (!filteredMembers.Any())
{
    <p class="text-muted">Aucun membre trouvé.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <colgroup>
                <col style="width:12%" />
                <col style="width:12%" />
                <col style="width:12%" />
                <col style="width:9%" />
                <col style="width:10%" />
                <col style="width:45%" />
            </colgroup>
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Prénom</th>
                    <th>Naissance</th>
                    <th>Baptisé</th>
                    <th>Statut</th>
                    <th>Carte</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var member in pagedMembers)
                {
                    <tr>
                        <td>@member.LastName</td>
                        <td>@member.FirstName</td>
                        <td>@(member.BirthdayLabel ?? "—")</td>
                        <td>@(member.IsBaptized ? "Oui" : "Non")</td>
                        <td>
                            @if (member.IsActive)
                            {
                                <span class="badge bg-success">Actif</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactif</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                <a href="/card/@member.Token" target="_blank">Voir la carte</a>
                                <a href="/admin/members/edit/@member.Id" class="btn btn-sm btn-outline-secondary">Modifier</a>
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        data-url="@CardUrl(member.Token)" onclick="copyToClipboard(this)">
                                    Copier le lien
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleActive(member)">
                                    @(member.IsActive ? "Désactiver" : "Réactiver")
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center">
        <span class="text-muted">
            @filteredMembers.Count membre(s) — page @currentPage sur @totalPages
        </span>
        <div class="btn-group">
            <button type="button" class="btn btn-outline-secondary" disabled="@(currentPage <= 1)" @onclick="() => GoToPage(currentPage - 1)">
                ‹ Précédent
            </button>
            <button type="button" class="btn btn-outline-secondary" disabled="@(currentPage >= totalPages)" @onclick="() => GoToPage(currentPage + 1)">
                Suivant ›
            </button>
        </div>
    </div>
}

@code {
    private const int PageSize = 25;

    private List<Member>? members;
    private string searchTerm = "";
    private int currentPage = 1;

    private string CardUrl(string token) => $"{Nav.BaseUri.TrimEnd('/')}/card/{token}";

    private List<Member> filteredMembers =>
        members is null
            ? []
            : string.IsNullOrWhiteSpace(searchTerm)
                ? members
                : members.Where(m => m.FullName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)).ToList();

    private int totalPages => Math.Max(1, (int)Math.Ceiling(filteredMembers.Count / (double)PageSize));

    private IEnumerable<Member> pagedMembers =>
        filteredMembers.Skip((Math.Min(currentPage, totalPages) - 1) * PageSize).Take(PageSize);

    private void ResetPage() => currentPage = 1;

    private void GoToPage(int page) => currentPage = Math.Clamp(page, 1, totalPages);

    protected override async Task OnInitializedAsync()
    {
        await LoadMembers();
    }

    private async Task LoadMembers()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        members = await db.Members.OrderBy(m => m.LastName).ThenBy(m => m.FirstName).ToListAsync();
    }

    private async Task ToggleActive(Member member)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var tracked = await db.Members.FindAsync(member.Id);
        if (tracked is not null)
        {
            tracked.IsActive = !tracked.IsActive;
            await db.SaveChangesAsync();
            member.IsActive = tracked.IsActive;
        }
    }
}
