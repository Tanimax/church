@page "/admin/ecole-dominicale"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>École Dominicale</PageTitle>

<h1>École Dominicale</h1>

<div class="d-flex justify-content-end mb-3">
    <button type="button" class="btn btn-primary" @onclick="OpenAddModal">+ Ajouter une classe</button>
</div>

@if (showAddModal)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" @onclick="CloseAddModal">
        <div class="modal-dialog" role="document" @onclick:stopPropagation="true">
            <div class="modal-content">
                <EditForm Model="addFormModel" OnValidSubmit="HandleAddSubmit">
                    <DataAnnotationsValidator />
                    <div class="modal-header">
                        <h5 class="modal-title">Ajouter une classe</h5>
                        <button type="button" class="btn-close" aria-label="Fermer" @onclick="CloseAddModal"></button>
                    </div>
                    <div class="modal-body">
                        <ValidationSummary />
                        <div class="mb-3">
                            <label class="form-label">Nom de la classe</label>
                            <InputText class="form-control" @bind-Value="addFormModel.Name" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-link" @onclick="CloseAddModal">Annuler</button>
                        <button type="submit" class="btn btn-primary">Créer la classe</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@if (classes is null)
{
    <p><em>Chargement...</em></p>
}
else if (!classes.Any())
{
    <p class="text-muted">Aucune classe créée.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Membres</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in classes)
                {
                    <tr>
                        <td>@c.Name</td>
                        <td>@memberCounts.GetValueOrDefault(c.Id, 0)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<SundayClass>? classes;
    private Dictionary<int, int> memberCounts = new();

    private bool showAddModal;
    private SundayClassFormModel addFormModel = new();

    protected override async Task OnInitializedAsync() => await LoadClasses();

    private async Task LoadClasses()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        classes = await db.SundayClasses.OrderBy(c => c.Name).ToListAsync();
        memberCounts = await db.Members
            .Where(m => m.SundayClassId != null)
            .GroupBy(m => m.SundayClassId!.Value)
            .Select(g => new { ClassId = g.Key, Count = g.Count() })
            .ToDictionaryAsync(x => x.ClassId, x => x.Count);
    }

    private void OpenAddModal()
    {
        addFormModel = new SundayClassFormModel();
        showAddModal = true;
    }

    private void CloseAddModal() => showAddModal = false;

    private async Task HandleAddSubmit()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        db.SundayClasses.Add(new SundayClass
        {
            Name = addFormModel.Name.Trim(),
            CreatedAt = DateTime.UtcNow
        });
        await db.SaveChangesAsync();

        showAddModal = false;
        await LoadClasses();
    }
}
