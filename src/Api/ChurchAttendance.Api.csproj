<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The Blazor Server app: pages, HTTP endpoints, authentication, and the composition root
       (Program.cs) that wires Application and Infrastructure together. -->
  <PropertyGroup>
    <!-- Kept from before the split into layers: the assembly name is part of the Data
         Protection key ring's application name and of the scoped CSS bundle
         (ChurchAttendance.styles.css), and the namespaces stay ChurchAttendance.*. -->
    <AssemblyName>ChurchAttendance</AssemblyName>
    <RootNamespace>ChurchAttendance</RootNamespace>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <!-- Needed by `dotnet ef`, which uses this project as its startup project. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="ChurchAttendance.SharedKernel" />
    <Using Include="ChurchAttendance.Domain" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\ChurchAttendance.Application.csproj" />
    <ProjectReference Include="..\Infrastructure\ChurchAttendance.Infrastructure.csproj" />
    <ProjectReference Include="..\SharedKernel\ChurchAttendance.SharedKernel.csproj" />
  </ItemGroup>

</Project>
