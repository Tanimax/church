@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    <span>Connecté : @context.User.Identity?.Name</span>
                    <ChangePasswordButton />
                    <form method="post" action="/admin/logout">
                        <button type="submit" class="btn btn-link p-0">Déconnexion</button>
                    </form>
                </Authorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            <Breadcrumb />
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    @* Last resort, when an interactive page's connection stops after an unexpected error.
       Pages handle their own failures first (AppComponentBase.TryRunAsync). *@
    Une erreur inattendue est survenue et la page ne répond plus.
    <a href="." class="reload">Recharger la page</a>
    <span class="dismiss">🗙</span>
</div>

<script src="/js/idle-logout.js"></script>
