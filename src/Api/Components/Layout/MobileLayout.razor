@inherits LayoutComponentBase

<div class="mobile-shell">
    <AuthorizeView>
        <Authorized>
            <div class="mobile-topbar">
                <span class="mobile-topbar-user">@context.User.Identity?.Name</span>
                <form method="post" action="/admin/logout">
                    <button type="submit" class="mobile-logout-btn">Déconnexion</button>
                </form>
            </div>
        </Authorized>
    </AuthorizeView>

    <main class="mobile-content">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    @* Last resort, when an interactive page's connection stops after an unexpected error.
       Pages handle their own failures first (AppComponentBase.TryRunAsync). *@
    Une erreur inattendue est survenue et la page ne répond plus.
    <a href="." class="reload">Recharger la page</a>
    <span class="dismiss">🗙</span>
</div>
<script src="/js/idle-logout.js"></script>
