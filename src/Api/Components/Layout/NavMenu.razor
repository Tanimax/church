@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">ChurchAttendance</a>
    </div>
</div>

<input type="checkbox" title="Menu de navigation" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        @foreach (var entry in SiteMap.Menu)
        {
            if (entry is NavGroup group)
            {
                <AuthorizeView Policy="@group.Policy" Context="groupAuth">
                    <Authorized>
                        @* Opened on its own pages, so the current page's link is in view. The click
                           stays here: the panel's own handler would close the phone menu. *@
                        <details class="nav-group px-3" open="@SiteMap.Contains(group, CurrentPath)">
                            <summary class="nav-link" onclick="event.stopPropagation()">
                                <span class="bi bi-@(group.Icon)-nav-menu" aria-hidden="true"></span> @group.Title
                            </summary>
                            @foreach (var link in group.Pages)
                            {
                                <AuthorizeView Policy="@link.Policy" Roles="@link.Roles">
                                    <Authorized>
                                        <div class="nav-item nav-subitem">
                                            <NavLink class="nav-link" href="@link.Href" Match="@SiteMap.MatchFor(link)">@link.Title</NavLink>
                                        </div>
                                    </Authorized>
                                </AuthorizeView>
                            }
                        </details>
                    </Authorized>
                </AuthorizeView>
            }
            else if (entry is NavPage item)
            {
                <AuthorizeView Policy="@item.Policy" Roles="@item.Roles">
                    <Authorized>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="@item.Href" Match="@SiteMap.MatchFor(item)">
                                <span class="bi bi-@(item.Icon)-nav-menu" aria-hidden="true"></span> @item.Title
                            </NavLink>
                        </div>
                    </Authorized>
                </AuthorizeView>
            }
        }

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <form method="post" action="/admin/logout">
                        <button type="submit" class="nav-link btn btn-link p-0 text-start w-100">Déconnexion</button>
                    </form>
                </div>
            </Authorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private string CurrentPath => Navigation.ToBaseRelativePath(Navigation.Uri);
}
