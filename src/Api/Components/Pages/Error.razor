@page "/Error"
@using System.Diagnostics

@* Shown (outside Development) when a page request fails with an unexpected exception.
   No technical detail here: the request id is enough to find the error in the logs. *@

<PageTitle>Erreur</PageTitle>

<h1>Une erreur est survenue</h1>
<p>La page n'a pas pu s'afficher. Réessayez dans un instant ; si le problème continue, prévenez l'administrateur.</p>

@if (!string.IsNullOrEmpty(RequestId))
{
    <p class="text-muted small">Référence de l'erreur : <code>@RequestId</code></p>
}

<p><a href="/">Retour à l'accueil</a></p>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }

    // Same reference as the API's traceId, and the TraceId of the request's log lines.
    protected override void OnInitialized() =>
        RequestId = HttpContext is null ? Activity.Current?.TraceId.ToString() : Startup.ErrorHandlingSetup.RequestId(HttpContext);
}
