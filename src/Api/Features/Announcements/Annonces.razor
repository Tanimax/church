@page "/admin/annonces"
@attribute [Authorize(Policy = AuthorizationPolicies.ManageCommunication)]
@rendermode InteractiveServer
@inherits AppComponentBase
@using ChurchAttendance.Application.Announcements
@inject AnnouncementService AnnouncementService

<PageTitle>Annonces</PageTitle>

<h1>Annonces</h1>

<ErrorAlert Message="@pageError" />

@if (announcements is null)
{
    <p><em>Chargement...</em></p>
}
else
{
    <section class="deck d-flex flex-wrap align-items-end gap-2 mb-4">
        <div>
            <label class="form-label fw-semibold" for="sunday">Dimanche des annonces</label>
            <input id="sunday" type="date" class="form-control" @bind="sunday" @bind:after="ChangeSundayAsync" />
        </div>
        @if (sunday.DayOfWeek == DayOfWeek.Sunday)
        {
            <a class="btn btn-primary" href="@AnnouncementEndpoints.DeckUrl(sunday)" download>Télécharger le PowerPoint</a>
        }
        else
        {
            <span class="text-danger pb-2">Choisissez un dimanche.</span>
        }
    </section>

    <section class="theme mb-4">
        <label class="form-label fw-semibold" for="theme">
            Thème de @AnnouncementTexts.MonthName(sunday.Month) @sunday.Year
        </label>
        <div class="d-flex flex-wrap gap-2">
            <input id="theme" class="form-control theme-input" maxlength="@AnnouncementService.MaxThemeLength"
                   placeholder="Ex. : Octobre : Mois d'actions de grâces" @bind="theme" />
            <button type="button" class="btn btn-outline-primary" disabled="@savingTheme" @onclick="SaveThemeAsync">
                @(savingTheme ? "Enregistrement..." : "Enregistrer le thème")
            </button>
        </div>
        <div class="form-text">Sur la page de titre du PowerPoint des annonces, sous la date.</div>
        <ErrorAlert Message="@themeError" />
        @if (themeSaved)
        {
            <div class="alert alert-success mt-2" role="status">Thème enregistré.</div>
        }
    </section>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <button type="button" class="btn btn-primary" @onclick="OpenNew">+ Nouvelle annonce</button>
        <div class="form-check">
            <input id="showArchived" class="form-check-input" type="checkbox" @bind="showArchived" @bind:after="ReloadAsync" />
            <label class="form-check-label" for="showArchived">Voir les annonces archivées</label>
        </div>
    </div>

    <p class="text-muted">
        Annonces du dimanche @sunday.ToString("dd/MM/yyyy") :
        @announcements.Count(a => a.IsShownOn(sunday)) annonce(s). Un événement passé n'y figure plus.
    </p>

    <ErrorAlert Message="@listError" />

    @foreach (var group in announcements.GroupBy(a => a.Kind))
    {
        <h2 class="h5 mt-4">@AnnouncementTexts.KindLabel(group.Key)</h2>
        <ul class="list-unstyled announcements">
            @foreach (var announcement in group)
            {
                var shown = announcement.IsShownOn(sunday);
                <li class="announcement @(shown ? "" : "is-off")">
                    <div class="announcement-text">
                        @if (AnnouncementTexts.WhenLine(announcement) is { } when)
                        {
                            <div class="when">@when</div>
                        }
                        <div class="title">@announcement.Title</div>
                        @foreach (var detail in announcement.Details)
                        {
                            <div class="detail">
                                @if (detail.Label is not null)
                                {
                                    <span class="label">@detail.Label :</span>@(" ")
                                }
                                <span>@detail.Text</span>
                            </div>
                        }
                        @if (announcement.IsArchived)
                        {
                            <span class="badge text-bg-secondary">Archivée</span>
                        }
                        else if (!shown)
                        {
                            <span class="badge text-bg-light">Passée</span>
                        }
                    </div>
                    <div class="announcement-actions">
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => OpenEdit(announcement)">Modifier</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@archiving"
                                @onclick="() => SetArchivedAsync(announcement, !announcement.IsArchived)">
                            @(announcement.IsArchived ? "Restaurer" : "Archiver")
                        </button>
                    </div>
                </li>
            }
        </ul>
    }

    @if (announcements.Count == 0)
    {
        <p class="text-muted">Aucune annonce pour l'instant.</p>
    }
}

@if (draft is not null)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" @onclick="CloseForm">
        <div class="modal-dialog modal-lg" role="document" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(draft.Id == 0 ? "Nouvelle annonce" : "Modifier l'annonce")</h5>
                    <button type="button" class="btn-close" aria-label="Fermer" @onclick="CloseForm"></button>
                </div>
                <div class="modal-body">
                    <ErrorAlert Message="@formError" />

                    <div class="mb-3">
                        <label class="form-label" for="title">Ce qui a lieu</label>
                        <input id="title" class="form-control" maxlength="@AnnouncementService.MaxTitleLength"
                               placeholder="Ex. : Réunion de prière ici à l'église, suivie de l'étude biblique." @bind="draft.Title" />
                    </div>

                    <fieldset class="mb-3">
                        <legend class="form-label fs-6 mb-1">Quand ?</legend>
                        <div class="form-check form-check-inline">
                            <input id="dated" class="form-check-input" type="radio" name="when" checked="@draft.IsDated"
                                   @onchange="() => draft.IsDated = true" />
                            <label class="form-check-label" for="dated">À une date</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input id="weekly" class="form-check-input" type="radio" name="when" checked="@(!draft.IsDated)"
                                   @onchange="() => draft.IsDated = false" />
                            <label class="form-check-label" for="weekly">Chaque semaine, ou sans date</label>
                        </div>
                    </fieldset>

                    @if (draft.IsDated)
                    {
                        <div class="row">
                            <div class="col-sm-4 mb-3">
                                <label class="form-label" for="eventDate">Date</label>
                                <input id="eventDate" type="date" class="form-control" @bind="draft.Date" />
                            </div>
                            <div class="col-sm-4 mb-3">
                                <label class="form-label" for="eventTime">Heure</label>
                                <input id="eventTime" class="form-control" maxlength="@AnnouncementService.MaxEventTimeLength"
                                       placeholder="Ex. : à 18h00" @bind="draft.Time" />
                            </div>
                            <div class="col-sm-4 mb-3">
                                <label class="form-label" for="endDate">Jusqu'au (si plusieurs jours)</label>
                                <input id="endDate" type="date" class="form-control" @bind="draft.EndDate" />
                            </div>
                        </div>
                        <div class="form-text mb-3 mt-n2">L'annonce disparaît d'elle-même une fois la date passée.</div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label" for="schedule">Jour et heure (facultatif)</label>
                            <input id="schedule" class="form-control" maxlength="@AnnouncementService.MaxScheduleLength"
                                   placeholder="Ex. : Mercredi soir de 19h00 à 21h15" @bind="draft.Schedule" />
                            <div class="form-text">Vide pour une annonce permanente sans horaire (ex. : les malades).</div>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label" for="details">Détails (facultatif)</label>
                        <textarea id="details" class="form-control" rows="3" @bind="draft.Details"
                                  placeholder="Sujet : L'identité des ouvriers dans l'Église.&#10;N.B. : Soyez des nôtres !"></textarea>
                        <div class="form-text">Une ligne par détail. « Sujet : », « Tél. : », « N.B. : »… sont soulignés sur la diapositive.</div>
                    </div>

                    <div class="form-check mb-3">
                        <input id="external" class="form-check-input" type="checkbox" @bind="draft.IsExternal" />
                        <label class="form-check-label" for="external">Annonce d'une autre église</label>
                    </div>

                    <details class="mb-3" open="@(!string.IsNullOrWhiteSpace(draft.Heading))">
                        <summary class="form-text">Plus d'options</summary>
                        <label class="form-label mt-2" for="heading">Titre de section</label>
                        <input id="heading" class="form-control" maxlength="@AnnouncementService.MaxHeadingLength"
                               placeholder="Ex. : 2e jeûne annuel" @bind="draft.Heading" />
                        <div class="form-text">
                            En tête de sa diapositive. Sinon : @(draft.IsExternal ? $"« {AnnouncementTexts.ExternalHeading} »" : "aucun").
                        </div>
                    </details>

                    @{ var preview = draft.Preview(); }
                    <div class="preview">
                        <div class="form-text mb-1">Aperçu</div>
                        @if (AnnouncementTexts.Heading(preview) is { } heading)
                        {
                            <div class="preview-heading">@heading</div>
                        }
                        @if (AnnouncementTexts.WhenLine(preview) is { } when)
                        {
                            <div class="when">@when</div>
                        }
                        <div class="title">@(string.IsNullOrWhiteSpace(preview.Title) ? "…" : preview.Title)</div>
                        @foreach (var detail in preview.Details)
                        {
                            <div class="detail">
                                @if (detail.Label is not null)
                                {
                                    <span class="label">@detail.Label :</span>@(" ")
                                }
                                <span>@detail.Text</span>
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseForm">Annuler</button>
                    <button type="button" class="btn btn-primary" disabled="@saving" @onclick="SaveAsync">
                        @(saving ? "Enregistrement..." : "Enregistrer")
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private const string AccessDenied = "Accès refusé : seuls l'administrateur et le secrétariat peuvent gérer les annonces.";

    private DateOnly sunday;
    private List<Announcement>? announcements;
    private bool showArchived;
    private string? theme;

    private AnnouncementDraft? draft;

    private string? pageError;
    private string? listError;
    private string? formError;
    private string? themeError;
    private bool themeSaved;

    // True while a save or an archive runs: a burst of clicks acts once (a double "Enregistrer"
    // on a new announcement would otherwise create it twice).
    private bool saving;
    private bool savingTheme;
    private bool archiving;

    protected override async Task OnInitializedAsync()
    {
        sunday = AnnouncementService.UpcomingSunday;
        pageError = await TryRunAsync(async () =>
        {
            theme = await AnnouncementService.GetThemeAsync(sunday.Year, sunday.Month);
            await LoadAsync();
        }, "Impossible de charger les annonces");
    }

    private async Task LoadAsync() => announcements = await AnnouncementService.GetAllAsync(showArchived);

    // Another Sunday: its month may have another theme.
    private async Task ChangeSundayAsync()
    {
        themeSaved = false;
        themeError = null;
        pageError = await TryRunAsync(async () => theme = await AnnouncementService.GetThemeAsync(sunday.Year, sunday.Month),
            "Impossible de charger le thème du mois");
    }

    private async Task ReloadAsync() => listError = await TryRunAsync(LoadAsync, "Impossible de charger les annonces");

    private void OpenNew()
    {
        formError = null;
        draft = new AnnouncementDraft();
    }

    private void OpenEdit(Announcement announcement)
    {
        formError = null;
        draft = AnnouncementDraft.From(announcement);
    }

    private void CloseForm() => draft = null;

    private async Task SaveAsync()
    {
        // Set before the first await: Blazor runs the next click's handler as soon as this one awaits.
        if (saving || draft is null)
        {
            return;
        }
        saving = true;

        try
        {
            if (!await IsAuthorizedAsync(AuthorizationPolicies.ManageCommunication))
            {
                formError = AccessDenied;
                return;
            }

            Result<int>? result = null;
            formError = await TryRunAsync(async () => result = await AnnouncementService.SaveAsync(draft.ToForm()),
                "Impossible d'enregistrer l'annonce");
            if (formError is null && !result!.IsSuccess)
            {
                formError = result.Error!.Message;
            }
            if (formError is null)
            {
                draft = null;
                await ReloadAsync();
            }
        }
        finally
        {
            saving = false;
        }
    }

    private async Task SetArchivedAsync(Announcement announcement, bool archived)
    {
        if (archiving)
        {
            return;
        }
        archiving = true;

        try
        {
            if (!await IsAuthorizedAsync(AuthorizationPolicies.ManageCommunication))
            {
                listError = AccessDenied;
                return;
            }

            Result result = Result.Success();
            listError = await TryRunAsync(async () => result = await AnnouncementService.SetArchivedAsync(announcement.Id, archived),
                archived ? "Impossible d'archiver l'annonce" : "Impossible de restaurer l'annonce");
            if (listError is null && !result.IsSuccess)
            {
                listError = result.Error!.Message;
            }
            if (listError is null)
            {
                await ReloadAsync();
            }
        }
        finally
        {
            archiving = false;
        }
    }

    private async Task SaveThemeAsync()
    {
        if (savingTheme)
        {
            return;
        }
        savingTheme = true;
        themeSaved = false;

        try
        {
            if (!await IsAuthorizedAsync(AuthorizationPolicies.ManageCommunication))
            {
                themeError = AccessDenied;
                return;
            }

            Result result = Result.Success();
            themeError = await TryRunAsync(async () => result = await AnnouncementService.SaveThemeAsync(sunday.Year, sunday.Month, theme),
                "Impossible d'enregistrer le thème");
            if (themeError is null && !result.IsSuccess)
            {
                themeError = result.Error!.Message;
            }
            themeSaved = themeError is null;
        }
        finally
        {
            savingTheme = false;
        }
    }
}
