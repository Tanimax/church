@page "/admin/reports"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits AppComponentBase
@inject IAppDbContextFactory DbFactory
@inject ChurchClock Clock

<PageTitle>Rapport Dominical</PageTitle>

<h1>Rapport Dominical</h1>

<ErrorAlert Message="@reportError" />

<div class="row g-2 align-items-end mb-4">
    <div class="col-auto">
        <label class="form-label">Dimanche</label>
        <input type="date" class="form-control" @bind="selectedDate" @bind:after="LoadReport" />
    </div>
    <div class="col-auto">
        <a class="btn btn-outline-secondary" href="@ExportUrl" target="_blank">Exporter en CSV</a>
    </div>
</div>

@if (detailRows is null)
{
    <p><em>Chargement...</em></p>
}
else
{
    <p><strong>@detailRows.Count</strong> présent(s) le @selectedDate.ToString("dd/MM/yyyy").</p>

    <h4>Présences</h4>
    @if (!detailRows.Any())
    {
        <p class="text-muted">Aucune présence enregistrée ce dimanche.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead><tr><th>Nom</th><th>Heure</th></tr></thead>
                <tbody>
                    @foreach (var row in pagedPresentRows)
                    {
                        <tr>
                            <td>@row.FullName</td>
                            <td>@Clock.ToLocal(row.CheckedInAt).ToString("HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
            <span class="text-muted">
                @detailRows.Count présence(s) — page @presentPage sur @presentTotalPages
            </span>
            <div class="d-flex align-items-center gap-2">
                <label class="text-muted mb-0" for="presentPageSize">Par page</label>
                <select id="presentPageSize" class="form-select form-select-sm w-auto" @bind="presentPageSize" @bind:event="onchange" @bind:after="ResetPresentPage">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                    <option value="@int.MaxValue">Tous</option>
                </select>
                <div class="btn-group">
                    <button type="button" class="btn btn-outline-secondary" disabled="@(presentPage <= 1)" @onclick="() => GoToPresentPage(presentPage - 1)">
                        ‹ Précédent
                    </button>
                    <button type="button" class="btn btn-outline-secondary" disabled="@(presentPage >= presentTotalPages)" @onclick="() => GoToPresentPage(presentPage + 1)">
                        Suivant ›
                    </button>
                </div>
            </div>
        </div>
    }

    <h4 class="mt-4">Membres absents ce dimanche</h4>
    @if (!absentMembers.Any())
    {
        <p class="text-muted">Aucun membre absent ce dimanche.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead><tr><th>Nom</th><th>Téléphone</th><th>Dernière présence</th></tr></thead>
                <tbody>
                    @foreach (var m in pagedAbsentMembers)
                    {
                        <tr>
                            <td>@m.FullName</td>
                            <td>@m.Phone</td>
                            <td>@(m.LastAttendance is null ? "Jamais" : m.LastAttendance.Value.ToString("dd/MM/yyyy"))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span class="text-muted">
                @absentMembers.Count absent(s) — page @absentPage sur @absentTotalPages
            </span>
            <div class="d-flex align-items-center gap-2">
                <label class="text-muted mb-0" for="absentPageSize">Par page</label>
                <select id="absentPageSize" class="form-select form-select-sm w-auto" @bind="absentPageSize" @bind:event="onchange" @bind:after="ResetAbsentPage">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                    <option value="@int.MaxValue">Tous</option>
                </select>
                <div class="btn-group">
                    <button type="button" class="btn btn-outline-secondary" disabled="@(absentPage <= 1)" @onclick="() => GoToAbsentPage(absentPage - 1)">
                        ‹ Précédent
                    </button>
                    <button type="button" class="btn btn-outline-secondary" disabled="@(absentPage >= absentTotalPages)" @onclick="() => GoToAbsentPage(absentPage + 1)">
                        Suivant ›
                    </button>
                </div>
            </div>
        </div>
    }
}

@code {
    private DateOnly selectedDate;

    private List<SundayPresence>? detailRows;
    private List<AbsentMember> absentMembers = new();

    private int presentPage = 1;
    private int presentPageSize = 10;
    private int absentPage = 1;
    private int absentPageSize = 10;

    private int presentTotalPages => Math.Max(1, (int)Math.Ceiling((detailRows?.Count ?? 0) / (double)presentPageSize));
    private IEnumerable<SundayPresence> pagedPresentRows =>
        (detailRows ?? []).Skip((Math.Min(presentPage, presentTotalPages) - 1) * presentPageSize).Take(presentPageSize);

    private int absentTotalPages => Math.Max(1, (int)Math.Ceiling(absentMembers.Count / (double)absentPageSize));
    private IEnumerable<AbsentMember> pagedAbsentMembers =>
        absentMembers.Skip((Math.Min(absentPage, absentTotalPages) - 1) * absentPageSize).Take(absentPageSize);

    private void ResetPresentPage() => presentPage = 1;
    private void ResetAbsentPage() => absentPage = 1;
    private void GoToPresentPage(int page) => presentPage = Math.Clamp(page, 1, presentTotalPages);
    private void GoToAbsentPage(int page) => absentPage = Math.Clamp(page, 1, absentTotalPages);

    private string ExportUrl => $"/admin/reports/export.csv?start={selectedDate:yyyy-MM-dd}&end={selectedDate:yyyy-MM-dd}";

    protected override async Task OnInitializedAsync()
    {
        selectedDate = Clock.MostRecentSunday;
        await LoadReport();
    }

    private string? reportError;

    // Initial load and every filter change: a failure shows a message instead of breaking the page.
    private async Task LoadReport() =>
        reportError = await TryRunAsync(LoadReportCore, "Impossible de charger le rapport");

    private async Task LoadReportCore()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        detailRows = await AttendanceReportService.GetPresencesAsync(db, selectedDate, selectedDate);
        absentMembers = await AttendanceReportService.GetAbsentMembersAsync(
            db, detailRows.Select(p => p.MemberId).ToHashSet());

        ResetPresentPage();
        ResetAbsentPage();
    }
}
