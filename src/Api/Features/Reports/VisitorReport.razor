@page "/admin/reports/visiteurs"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits AppComponentBase
@inject IAppDbContextFactory DbFactory
@inject ChurchClock Clock
@inject NavigationManager Nav

<PageTitle>Rapport Visiteurs</PageTitle>

<h1>Rapport Visiteurs</h1>

<ErrorAlert Message="@reportError" />

<div class="card mb-4" style="max-width:360px;">
    <div class="card-body text-center">
        <h5 class="card-title">Fiche visiteur à partager</h5>
        <img src="/visitor/qr.png" alt="QR code fiche visiteur" style="max-width:180px;" />
        <div class="input-group mt-2">
            <input type="text" class="form-control form-control-sm" readonly value="@VisitorFormUrl" />
            <button type="button" class="btn btn-sm btn-outline-secondary" data-url="@VisitorFormUrl" onclick="copyToClipboard(this)">
                Copier le lien
            </button>
        </div>
    </div>
</div>

<div class="mb-3">
    <label class="form-label">Dimanche</label>
    <input type="date" class="form-control w-auto" @bind="selectedDate" @bind:after="LoadReport" />
</div>

@if (visitors is null)
{
    <p><em>Chargement...</em></p>
}
else if (!visitors.Any())
{
    <p class="text-muted">Aucun visiteur enregistré pour cette date.</p>
}
else
{
    <table class="table table-sm table-striped">
        <thead>
            <tr>
                <th>Nom complet</th>
                <th>Téléphone</th>
                <th>Email</th>
                <th>Heure</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var v in visitors)
            {
                <tr>
                    <td>@v.FullName</td>
                    <td>@v.Phone</td>
                    <td>@v.Email</td>
                    <td>@Clock.ToLocal(v.CreatedAt).ToString("HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private DateOnly selectedDate;
    private List<Visitor>? visitors;

    private string VisitorFormUrl => PublicUrls.VisitorForm(Nav.BaseUri);

    protected override async Task OnInitializedAsync()
    {
        selectedDate = Clock.Today;
        await LoadReport();
    }

    private string? reportError;

    // Initial load and every filter change: a failure shows a message instead of breaking the page.
    private async Task LoadReport() =>
        reportError = await TryRunAsync(LoadReportCore, "Impossible de charger le rapport");

    private async Task LoadReportCore()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        visitors = await db.Visitors
            .Where(v => v.VisitDate == selectedDate)
            .OrderBy(v => v.CreatedAt)
            .ToListAsync();
    }
}
