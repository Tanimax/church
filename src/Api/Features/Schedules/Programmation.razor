@page "/admin/programmation"
@attribute [Authorize(Policy = AuthorizationPolicies.ManageCommunication)]
@rendermode InteractiveServer
@inherits AppComponentBase
@inject ScheduleService ScheduleService

<PageTitle>Programmation</PageTitle>

<h1>Programmation des services</h1>

<ErrorAlert Message="@pageError" />

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <button type="button" class="btn btn-outline-secondary" disabled="@(form is null)" @onclick="() => GoToQuarterAsync(-1)">
        ◀ Trimestre précédent
    </button>
    <div class="text-center">
        <div class="fw-bold">Service dominical — T@(quarter) @year</div>
        <div>@ScheduleTexts.QuarterPeriod(year, quarter)</div>
    </div>
    <button type="button" class="btn btn-outline-secondary" disabled="@(form is null)" @onclick="() => GoToQuarterAsync(1)">
        Trimestre suivant ▶
    </button>
</div>

@if (form is null)
{
    <p><em>Chargement...</em></p>
}
else
{
    <p class="text-muted">
        @if (!form.Exists)
        {
            <span>Ce trimestre n'est pas encore enregistré.</span>
        }
        else if (form.MissingCount > 0)
        {
            <span>@form.MissingCount dimanche(s) à compléter.</span>
        }
        else
        {
            <span>Tous les dimanches sont complétés.</span>
        }
    </p>

    <datalist id="schedule-names">
        @foreach (var name in suggestions)
        {
            <option value="@name"></option>
        }
    </datalist>

    <div class="table-responsive">
        <table class="table align-middle schedule">
            <thead>
                <tr><th>Date</th><th>Dirigeant(e)</th><th>Prédicateur(trice)</th></tr>
            </thead>
            <tbody>
                @foreach (var row in form.Rows)
                {
                    <tr>
                        <td class="schedule-date month-@ScheduleTexts.MonthInQuarter(row.Date)">@ScheduleTexts.ShortDate(row.Date)</td>
                        <td>
                            <input class="form-control" list="schedule-names" maxlength="@ScheduleService.MaxNameLength"
                                   aria-label="Dirigeant(e) du @ScheduleTexts.ShortDate(row.Date)" @bind="row.Leader" />
                        </td>
                        <td>
                            <input class="form-control" list="schedule-names" maxlength="@ScheduleService.MaxNameLength"
                                   aria-label="Prédicateur(trice) du @ScheduleTexts.ShortDate(row.Date)" @bind="row.Preacher" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mb-3">
        <label class="form-label" for="footerNote">Note en bas de page (N.B.)</label>
        <textarea id="footerNote" class="form-control" rows="2" maxlength="@ScheduleService.MaxFooterLength" @bind="form.FooterNote"></textarea>
    </div>

    <ErrorAlert Message="@saveError" />
    @if (saved)
    {
        <div class="alert alert-success" role="status">Programmation enregistrée.</div>
    }

    <button type="button" class="btn btn-primary" disabled="@saving" @onclick="SaveAsync">
        @(saving ? "Enregistrement..." : "Enregistrer")
    </button>
}

@code {
    private int year;
    private int quarter;
    private ScheduleFormModel? form;
    private List<string> suggestions = [];

    private string? pageError;
    private string? saveError;
    private bool saved;

    // True while saving: a burst of clicks saves once.
    private bool saving;

    protected override async Task OnInitializedAsync()
    {
        (year, quarter) = ScheduleService.CurrentQuarter;
        pageError = await TryRunAsync(LoadAsync, "Impossible de charger la programmation");
    }

    private async Task LoadAsync()
    {
        form = await ScheduleService.GetAsync(year, quarter);
        suggestions = await ScheduleService.GetNameSuggestionsAsync();
    }

    private async Task GoToQuarterAsync(int step)
    {
        var index = year * 4 + (quarter - 1) + step;
        (year, quarter) = (index / 4, index % 4 + 1);
        form = null;
        saveError = null;
        saved = false;
        pageError = await TryRunAsync(LoadAsync, "Impossible de charger la programmation");
    }

    private async Task SaveAsync()
    {
        // Set before the first await: Blazor runs the next click's handler as soon as this one awaits.
        if (saving || form is null)
        {
            return;
        }
        saving = true;
        saved = false;

        try
        {
            if (!await IsAuthorizedAsync(AuthorizationPolicies.ManageCommunication))
            {
                saveError = "Accès refusé : seuls l'administrateur et le secrétariat peuvent modifier la programmation.";
                return;
            }

            Result result = Result.Success();
            saveError = await TryRunAsync(async () => result = await ScheduleService.SaveAsync(form),
                "Impossible d'enregistrer la programmation");
            if (saveError is null && !result.IsSuccess)
            {
                saveError = result.Error!.Message;
            }
            if (saveError is null)
            {
                saved = true;
                pageError = await TryRunAsync(LoadAsync, "Impossible de recharger la programmation");
            }
        }
        finally
        {
            saving = false;
        }
    }
}
