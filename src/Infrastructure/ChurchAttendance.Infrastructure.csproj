<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything that touches the outside world: PostgreSQL (AppDbContext and its
       migrations), the email API, password hashing, member card images. -->

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="PDFsharp-MigraDoc" />
    <PackageReference Include="SixLabors.ImageSharp" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fonts of the schedule PDF, inside the assembly: no dependency on the machine's fonts.
         And the church's announcements template, the base of every projected deck. -->
    <EmbeddedResource Include="Documents/Assets/*.ttf" />
    <EmbeddedResource Include="Documents/Assets/annonces-modele.pptx" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\ChurchAttendance.Application.csproj" />
    <ProjectReference Include="..\Domain\ChurchAttendance.Domain.csproj" />
    <ProjectReference Include="..\SharedKernel\ChurchAttendance.SharedKernel.csproj" />
  </ItemGroup>

</Project>
